<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.crypto-engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_PROJECT_ROOT/predmarket-scanner/deploy/run_crypto_engine_forever.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_PROJECT_ROOT/predmarket-scanner</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_PROJECT_ROOT/predmarket-scanner/data/launchd_crypto_engine.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_PROJECT_ROOT/predmarket-scanner/data/launchd_crypto_engine.err.log</string>
</dict>
</plist>
