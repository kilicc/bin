[Unit]
Description=Binance Elite 9006 MEGA Mainnet Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pro
Group=pro
WorkingDirectory=/opt/binancex/predmarket-scanner
Environment=NO_PROXY=*
Environment=no_proxy=*
Environment=PYTHONUNBUFFERED=1
Environment=ELITE_BIND_HOST=127.0.0.1
ExecStartPre=/bin/mkdir -p /opt/binancex/predmarket-scanner/logs
ExecStart=/opt/binancex/predmarket-scanner/run_binance_elite_mega_9006_mainnet.sh
Restart=always
RestartSec=10
LimitNOFILE=65535
TimeoutStopSec=30

StandardOutput=append:/opt/binancex/predmarket-scanner/logs/binance_elite_mega_9006_mainnet.log
StandardError=append:/opt/binancex/predmarket-scanner/logs/binance_elite_mega_9006_mainnet.log

[Install]
WantedBy=multi-user.target
