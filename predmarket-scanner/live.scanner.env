# Canlı — mirror: paper ile aynı giriş, CLOB gerçek emir
# ./run_live_scanner.sh

POLYMARKET_LIVE_TRADING=1
POLYMARKET_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY_LOSS
POLYMARKET_LEARN_READONLY=1

# Paper ile hizalı (bakiye ~$7 → 1 açık × $5)
LIVE_ENTRY_PROFILE=mirror
MAX_POSITION_USD=5
MAX_OPEN_POSITIONS=1
POLYMARKET_MIN_ORDER_SIZE=5
LIVE_MAX_ENTRY_PRICE=0
LIVE_MIRROR_ALLOW_FLAT_MOM=1
LIVE_MIN_STAKE_USD=0.85

MAX_HOURS_TO_CLOSE=48
MIN_HOURS_TO_CLOSE=2
EDGE_THRESHOLD=0.065
KELLY_FRACTION=0.25
SCAN_INTERVAL_SEC=40
POSITION_CHECK_SEC=5
LIVE_SCAN_FUNNEL=1

LIVE_SIMPLE_EXIT=1
# TP: açılış maliyetinin (stake) %1 kâr → sat
TAKE_PROFIT_STAKE_PCT=0.01
STOP_LOSS_STAKE_PCT=0.02
TP_TRIGGER_FRAC=1.0
LIVE_DISABLE_SWAP=1
# Aynı maç başlığında tek pozisyon (Pistons/Cav O/U + spread yığını yok)
LIVE_ONE_PER_EVENT=1

# SL geçmişi olan türler kapalı
VETO_LIVE_CRYPTO_STRIKE=1
VETO_LIVE_ESPORTS_OUTRIGHT=1
VETO_EUROVISION_RANKING=1
VETO_DAILY_UP_OR_DOWN=1
VETO_VOLATILE_NARRATIVE=1

LIVE_DB_PATH=data/live.db
LIVE_USE_WALLET_BALANCE=1
