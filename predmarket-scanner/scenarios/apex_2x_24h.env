# ═══ APEX 2×24H — tüm varyasyonların birleşimi (hedef ~$22k→$44k / 24s, garanti değil) ═══
# insane_24h.env üstüne yüklenir — run_apex_2x_24h.sh veya run_paper_stack.sh
APEX_2X_24H=1
PROFILE_NAME=apex_2x_24h
PROFILE_VERSION=2

# ── Giriş: maksimum fırsat ───────────────────────────────────────────────────
EDGE_THRESHOLD=0.038
KELLY_FRACTION=0.55
PAPER_MIN_ENTRY_SCORE=0
SCAN_INTERVAL_SEC=12
POSITION_CHECK_SEC=2

# ── Stake: INSANE büyük poz + daily_2x katman ─────────────────────────────
MAX_POSITION_USD=1200
PAPER_TARGET_STAKE_USD=1800
PAPER_MIN_POSITION_USD=400
PAPER_MAX_OPEN_STAKE_PCT=0.90
MAX_OPEN_POSITIONS=48
GAP_STAKE_CAP_80=1200
GAP_STAKE_CAP_70=1200

PAPER_ALLOW_STACK=1
STACK_MAX_PER_MARKET=4
STACK_MAX_SAME_SIDE=3
STACK_MIN_INTERVAL_SEC=90
STACK_MIN_EDGE_GAP=0.010
STACK_MIN_PRICE_MOVE=0.005
STACK_STAKE_FRAC=0.42
STACK_LAYER_DECAY=0.82
STACK_MAX_STAKE_PER_MARKET_USD=2400
STACK_DAILY_LIMIT_MULT=4

# ── TP: sık micro + agresif runner (hibrit) ───────────────────────────────
TAKE_PROFIT_STAKE_PCT=0.006
FAST_TP_MAX_HOURS=12
FAST_TP_STAKE_PCT=0.004
ULTRA_FAST_TP_MAX_HOURS=2
ULTRA_FAST_TP_STAKE_PCT=0.003
QUICK_TP_EDGE_MIN=0.065
QUICK_TP_STAKE_PCT=0.004
NANO_TP_MAX_HOURS=24
NANO_TP_STAKE_PCT=0.002
TP_TRIGGER_FRAC=0.96
TP_DROUGHT_MINUTES=2
TP_DROUGHT_STAKE_PCT=0.003

HYBRID_TP_ENABLED=1
HYBRID_TP_SPIKE_THRESHOLD=0.46
HYBRID_TP_RUNNER_MIN_PCT=0.18
HYBRID_TP_RUNNER_MAX_PCT=0.28
HYBRID_TP_TRAIL_ENABLED=1
HYBRID_TP_DROUGHT_ENABLED=1
HYBRID_TP_DROUGHT_MINUTES=2
HYBRID_TP_FAST_BASE_PCT=0.004
HYBRID_TP_FAST_NANO_PCT=0.0015
HYBRID_TP_FAST_TRIGGER_FRAC=0.96

# ── SL: sıkı (sermaye koru, çok işlem) ────────────────────────────────────
STOP_LOSS_STAKE_PCT=0.025
SL_CATASTROPHIC_PCT=0.06

# ── Spor / sıkışma çıkışları (sohbet sonu + drift) ────────────────────────
SPORTS_EARLY_TP_DISCOUNT=0.028
TP_SCRATCH_MIN_AGE_MIN=30
TP_SCRATCH_MIN_PNL_PCT=0.002
STALE_LONG_TP_MIN_PNL_PCT=0.0012
SPORTS_DRIFT_SL_PCT=0.012
SPORTS_DRIFT_MIN_AGE_MIN=45
LONG_STALE_MIN_AGE_HOURS=1.5
LONG_SPORTS_MAX_OPEN=2
PAPER_ONE_PER_EVENT=1
MARKET_MIN_REOPEN_SEC=300

# ── Güvenlik (çift giriş, slip, canlı O/U) ────────────────────────────────
ENTRY_CLOB_MAX_SLIPPAGE=0.025
VETO_LIVE_SPORTS_TOTALS=1
VETO_SPORTS_TOTALS_MAX_HOURS=12
SWAP_MIN_QUALITY_GAP=0.06
SWAP_COOLDOWN_SEC=60
MAX_SPREAD=0.05
SL_COOLDOWN_MINUTES=25
MAX_HOURS_TO_CLOSE=20
MIN_HOURS_TO_CLOSE=0.75
MAX_HOLD_HOURS=12

# ── Öğrenme: sık rapor, 2× hedef takibi ───────────────────────────────────
TRADE_REPORT_INTERVAL_CYCLES=6
TRADE_REPORT_LAST_N=120
TRADE_REPORT_ON_START=1
APEX_TARGET_MULTIPLIER=2.0
APEX_REPORT_EVERY_CLOSES=6
VETO_EUROVISION_RANKING=0
VETO_DAILY_UP_OR_DOWN=0
