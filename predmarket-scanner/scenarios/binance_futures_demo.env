# ═══ BINANCE FUTURES DEMO v2 — port 8210 (sıfırdan + çok kaynaklı analiz) ═══
PROFILE_NAME=binance_futures_demo
SCENARIO_LABEL=binance_futures_demo

BN_FUT_MODE=testnet
BN_FUT_DB_PATH=data/binance_futures_demo.db
BN_FUT_DASHBOARD_PORT=8210
BN_FUT_START_BALANCE=5000
# Copy Trading için ayrı balance (USDC)
BN_FUT_COPY_START_BALANCE=5000

# Sıfırdan başla (DB sıfırlanır — ilk çalıştırmada 1 yapın, sonra 0)
BN_FUT_FRESH_START=0
BN_FUT_REFRESH_DB=0

BN_FUT_ACTIVE_CAPITAL_PCT=0.55
BN_FUT_TARGET_DAILY_PCT=0.50

# ═══ Portföy backtest: adv_alpha_max (6ay 22 coin, +274% sim) — canlı güvenli ═══
BN_FUT_STRATEGY_PROFILE=standard
BN_FUT_TP_PCT=0.025
BN_FUT_SL_PCT=0.009
BN_FUT_SL_MIN_HOLD_SEC=120
BN_FUT_SL_BUFFER_PCT=0.0015
BN_FUT_SL_ATR_MULT=1.35
BN_FUT_CANDLE_INTERVAL=15m
BN_FUT_SCAN_INTERVAL_SEC=14
BN_FUT_POSITION_CHECK_SEC=3
BN_FUT_MIN_SCORE=1.9
BN_FUT_KELLY=0.36
BN_FUT_MAX_POSITION_USD=220
BN_FUT_MIN_POSITION_USD=35
BN_FUT_MAX_OPEN=6
BN_FUT_LEVERAGE=5
BN_FUT_LEVERAGE_MIN=5
BN_FUT_LEVERAGE_MAX=8
BN_FUT_SCALP_MOM_THRESH=0.0035
BN_FUT_SCALP_LEV_MULT=1.22
BN_FUT_SCALP_STAKE_MULT=1.18
BN_FUT_SCALP_BT_HOLD_BARS=20

# Pozisyon yönetimi — isolated margin, stale TP, kademeli runner
BN_FUT_MARGIN_TYPE=isolated
BN_FUT_STALE_MIN_AGE_SEC=2700
BN_FUT_STALE_TP_MOVE_PCT=0.02
BN_FUT_STALE_TP_ROI_PCT=0.02
BN_FUT_RUNNER_MIN_CONF=4.0
BN_FUT_RUNNER_MIN_SCORE=3.5
BN_FUT_RUNNER_MIN_MOM_TAGS=2
BN_FUT_RUNNER_MAX_MOVE_PCT=0.08
BN_FUT_TIER_ROI_PCTS=0.10,0.20,0.30
BN_FUT_TIER_CLOSE_FRACS=0.33,0.33,0.34
BN_FUT_MIN_SIGNAL_PARTS=2
BN_FUT_MIN_SIGNAL_PART_SCORE=0.25
BN_FUT_LEARN_MIN_TRADES=3
BN_FUT_BT_VETO_WR=0.40

# Mark price WebSocket (1s) + panel poll (ms)
BN_FUT_MARK_WS=1
BN_FUT_MARK_WS_MAX_AGE_SEC=3
BN_FUT_PANEL_POLL_MS=500
BN_FUT_PANEL_FULL_POLL_MS=12000
BN_FUT_SYNC_INTERVAL_SEC=20
BN_FUT_SIGNAL_REFRESH_SEC=22
BN_FUT_LIVE_POSITION_POLL_SEC=2.5
BN_FUT_LIVE_BALANCE_POLL_SEC=10
BN_FUT_LIVE_REST_TIMEOUT_SEC=4
# Taker komisyon oranı (açılış+kapanış notional üzerinden)
BN_FUT_TAKER_FEE_RATE=0.0004

BN_FUT_WATCHLIST=WIF,AVAX,INJ,APT,LINK,TRX,NEAR,FIL,ATOM,SUI,ADA,OP,BNB,DOGE,ETH,LTC,ARB,SOL

# Çok kaynaklı analiz
BN_FUT_CEX_ARB=1
BN_FUT_GAP_ANALYSIS=1
BN_FUT_FLOW_ANALYSIS=1
BN_FUT_NEWS=1
BN_FUT_LEARNING=1
BN_FUT_BACKTEST_START=1
BN_FUT_BACKTEST_DAYS=5

# Hedge kapalı — one-way net pozisyon (borsa ile senkron)
BN_FUT_HEDGE_ENABLED=0
BN_FUT_HEDGE_PROACTIVE=0

BINANCE_FUTURES_TESTNET=1
BINANCE_FUTURES_DEMO=1

BN_FUT_EDU_STRATEGY_ID=adv_alpha_max
BN_FUT_EDU_MEMORY=1
BN_FUT_EDU_MACD=0

BN_FUT_PORTFOLIO_ENGINE=1

BN_FUT_PORTFOLIO_RETURN_PCT=273.69

# ═══ COPY TRADING — En iyi yatırımcıları aynala (eğitim/strateji modülünden BAĞIMSIZ) ═══
BN_FUT_COPY_ENABLED=1
# APIcord API key (opsiyonel — ücretsiz tier: 100 req/day, ücretli: unlimited)
BN_FUT_COPY_API_KEY=
BN_FUT_COPY_MAX_TRADERS=10
BN_FUT_COPY_MIN_ROI=50.0
BN_FUT_COPY_MIN_WR=0.55
BN_FUT_COPY_MAX_POSITIONS=5
BN_FUT_COPY_ALLOCATION_PCT=30.0
BN_FUT_COPY_REFRESH_SEC=60
BN_FUT_COPY_DISCOVER_SEC=3600
