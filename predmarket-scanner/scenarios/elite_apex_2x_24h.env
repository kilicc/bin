# ═══ ELITE APEX 2×24H — 5 port sentezi, $22k→$44k hedef (garanti değil) ═══
# Temel: 8180 global_2x (en yüksek PnL) + 8170 hız + 8150 kalite + 8160 risk koruması
PROFILE_NAME=elite_apex_2x_24h
PROFILE_VERSION=1
SCENARIO_LABEL=elite_apex_2x_24h

ELITE_DECISION_MODE=formula_learned
ELITE_TARGET_HOURLY_USD=917
ELITE_TARGET_EQUITY_MULT=2.0
ELITE_TARGET_HOURS=24
ELITE_TARGET_REALISTIC_USD=
ELITE_ASSUMED_WR=0.58
ELITE_CLOSES_PER_HOUR=5
ELITE_MAX_BRIER=0.28
STARTING_BALANCE=22000

PAPER_DB_PATH=data/elite_apex_2x_24h.db
DASHBOARD_PORT=8200
DISABLE_LIVE_TRADING=1
ELITE_SCAN_STATS=1
ELITE_PACING_EDGE_BOOST_MAX=0.04

# Sermaye — global_2x'ten agresif: %62 deploy, WR ölçekli sınırsız üst
ELITE_ACTIVE_CAPITAL_PCT=0.62
ELITE_MIN_STAKE_USD=500
ELITE_MAX_STAKE_USD=0
ELITE_MAX_OPEN=14
ELITE_WR_LOOKBACK=35
ELITE_WR_MIN_TRADES=6
ELITE_STAKE_WR_MIN_MULT=0.40
ELITE_STAKE_WR_MAX_MULT=5.5

MAX_POSITION_USD=100000
GAP_STAKE_CAP_80=100000
GAP_STAKE_CAP_70=100000

# Giriş — 8180 + 8170: biraz daha fazla işlem, kalite korunur
# Plan A (sürdürülebilir R:R): TP ~1.8% / SL ~1.5% — 1 SL ≈ 1–2 TP tetik
ELITE_MIN_EDGE=0.048
ELITE_MIN_FORMULA_SCORE=0.52
ELITE_TP_STAKE_PCT=0.018
ELITE_SL_STAKE_PCT=0.015
ELITE_TP_TRIGGER_FRAC=0.92
ELITE_FORMULA_REFRESH_HOURS=12

# Hedge — 8180 (kayıp kes, sermaye dön)
ELITE_HEDGE_PROACTIVE=1
ELITE_HEDGE_TRIGGER_PCT=0.010
ELITE_HEDGE_PROACTIVE_PCT=0.005
ELITE_HEDGE_STAKE_FRAC=0.38

# Tarama — diğer elite portlarla aynı döngü (10s / 2s kontrol)
ELITE_SCAN_INTERVAL_SEC=10
ELITE_POSITION_CHECK_SEC=2

ENTRY_CLOB_MAX_SLIPPAGE=0.03
VETO_LIVE_SPORTS_TOTALS=0
VETO_SPORTS_TOTALS_MAX_HOURS=72
ELITE_VETO_ALL_SPORTS=0
PAPER_ONE_PER_EVENT=1
ELITE_SPORTS_MAX_HOURS=0
ELITE_SPORTS_MIN_SCORE_BOOST=0.10
ELITE_SPORTS_STAKE_MULT=0.50

# Risk — 8160 bracket/cluster + hızlı dönüş
ELITE_VETO_BRACKETS=1
ELITE_ONE_CLUSTER=1
ELITE_MIN_HOLD_BEFORE_SL_SEC=90
ELITE_MARKET_COOLDOWN_MIN=22
ELITE_MIN_ENTRY_PRICE=0.30
ELITE_MAX_ENTRY_PRICE=0.70

# Plan A: STALE-TP geciktirildi (TP'ye gelmesi için süre)
ELITE_STALE_TP_ENABLED=1
ELITE_STALE_TP_MIN_AGE_MIN=20
