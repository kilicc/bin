# ═══ Binance 9004 — $22k agresif 2×24h, ~%50 deploy, ~20 pozisyon, $250 min ═══
PROFILE_NAME=aggressive_9004_binance
SCENARIO_LABEL=aggressive_9004_binance
STARTING_BALANCE=22000

ELITE_TARGET_EQUITY_MULT=2.0
ELITE_TARGET_HOURS=24
ELITE_ASSUMED_WR=0.58
ELITE_CLOSES_PER_HOUR=5

# Sermaye: cüzdanın ~%50'si aktif işlem bandı; üst stake sınırı yok (0 = sınırsız)
ELITE_ACTIVE_CAPITAL_PCT=0.50
ELITE_MIN_STAKE_USD=250
ELITE_MAX_STAKE_USD=0
ELITE_MAX_OPEN=20
ELITE_WR_LOOKBACK=40
ELITE_WR_MIN_TRADES=5
ELITE_STAKE_WR_MIN_MULT=0.45
ELITE_STAKE_WR_MAX_MULT=5.0

MAX_POSITION_USD=100000
GAP_STAKE_CAP_80=100000
GAP_STAKE_CAP_70=100000

ELITE_MIN_EDGE=0.048
ELITE_MIN_FORMULA_SCORE=0.52
ELITE_TP_STAKE_PCT=0.10
ELITE_SL_STAKE_PCT=0.025
ELITE_TP_TRIGGER_FRAC=0.85
ELITE_FORMULA_REFRESH_HOURS=12

# Hedge / koruma (API & kontrol için env; Binance paper’da danışman)
ELITE_HEDGE_PROACTIVE=1
ELITE_HEDGE_TRIGGER_PCT=0.010
ELITE_HEDGE_PROACTIVE_PCT=0.005
ELITE_HEDGE_STAKE_FRAC=0.38

ELITE_SCAN_INTERVAL_SEC=10
ELITE_POSITION_CHECK_SEC=2
ENTRY_CLOB_MAX_SLIPPAGE=0.03

ELITE_MIN_HOLD_BEFORE_SL_SEC=120
ELITE_MARKET_COOLDOWN_MIN=5
ELITE_MIN_ENTRY_PRICE=0.30
ELITE_MAX_ENTRY_PRICE=0.70

# 10 dk: zararda değil, TP’ye ulaşamayan → kapat (STALE-TP); yeniden giriş cooldown sonrası mümkün
ELITE_STALE_TP_ENABLED=1
ELITE_STALE_TP_FORCE=1
ELITE_STALE_TP_MIN_AGE_MIN=10

DASHBOARD_PORT=9004
PAPER_DB_PATH=data/aggressive_9004_paper.db
