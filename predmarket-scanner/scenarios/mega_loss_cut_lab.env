# MEGA zarar kesimi — lab / paper önce test (9006 mainnet'e dokunmaz)
# Kullanım: set -a && source scenarios/mega_loss_cut_lab.env && set +a
#
# Sıra: paper veya düşük stake instance → 1–2 gün gözlem → 9006'ya kademeli

# Su altı zaman kesimi (evaluate_mega_exits bağlı)
MEGA_UNDERWATER_CUT=1
MEGA_UNDERWATER_MAX_SEC=75
MEGA_UNDERWATER_MIN_LOSS_USD=2.0
MEGA_UNDERWATER_KEEP_PEAK_FRAC=0.40

# Klasik SL (panel evaluate_position_exit; varsayılan mega'da kapalı)
# Önce sadece underwater ile test edin; SL'yi ikinci aşamada açın:
# MEGA_DISABLE_SL_EXIT=0

# Görünürlük (panel uPnL yumuşatmasını kapat — test sırasında önerilir)
# MEGA_MARK_UNREAL_BLEND=0
