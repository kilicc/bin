# Binance Futures Demo — ayar özeti (2026-05-17)
# API anahtarları: .env → BINANCE_FUTURES_API_KEY / SECRET
# Tam runtime: data/binance_futures_settings_snapshot.json

PROFILE_NAME=binance_futures_demo
BN_FUT_MODE=testnet
BN_FUT_DB_PATH=data/binance_futures_demo.db
BN_FUT_DASHBOARD_PORT=8210
BN_FUT_START_BALANCE=5000
BN_FUT_FRESH_START=0
BN_FUT_REFRESH_DB=0

BN_FUT_ACTIVE_CAPITAL_PCT=0.50
BN_FUT_TARGET_DAILY_PCT=0.50
BN_FUT_TP_PCT=0.03
BN_FUT_SL_PCT=0.05
BN_FUT_SCAN_INTERVAL_SEC=25
BN_FUT_POSITION_CHECK_SEC=5
BN_FUT_MAX_OPEN=10
BN_FUT_MIN_POSITION_USD=30
BN_FUT_MAX_POSITION_USD=150
BN_FUT_KELLY=0.28
BN_FUT_MIN_SCORE=2.2
BN_FUT_LEVERAGE=5

BN_FUT_WATCHLIST=BTC,ETH,SOL,BNB,XRP,DOGE,AVAX,LINK,APT
BN_FUT_CANDLE_INTERVAL=15m

BN_FUT_CEX_ARB=1
BN_FUT_GAP_ANALYSIS=1
BN_FUT_FLOW_ANALYSIS=1
BN_FUT_NEWS=1
BN_FUT_LEARNING=1
BN_FUT_BACKTEST_START=1
BN_FUT_BACKTEST_DAYS=5

BN_FUT_HEDGE_ENABLED=0
BN_FUT_HEDGE_PROACTIVE=0

BINANCE_FUTURES_TESTNET=1
