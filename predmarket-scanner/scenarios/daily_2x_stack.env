# ═══ Günlük 2× hedefi — küçük katmanlar, aynı markette kontrollü yığın ═══
# Paper: PAPER_ALLOW_STACK=1  |  Canlı: LIVE_ALLOW_STACK=1 (dikkatli)
PROFILE_NAME=daily_2x_stack

# ── Katmanlı giriş (ana kurallar korunur: edge, mom, spread, SL cooldown) ──
PAPER_ALLOW_STACK=1
STACK_MAX_PER_MARKET=4
STACK_MAX_SAME_SIDE=3
STACK_MIN_INTERVAL_SEC=120
STACK_MIN_EDGE_GAP=0.012
STACK_MIN_PRICE_MOVE=0.006
STACK_STAKE_FRAC=0.38
STACK_LAYER_DECAY=0.85
STACK_MAX_STAKE_PER_MARKET_USD=600
STACK_DAILY_LIMIT_MULT=3

# ── Küçük pozisyon, çok sepet, hızlı TP (INSANE ile birlikte source edilir) ──
MAX_POSITION_USD=75
PAPER_TARGET_STAKE_USD=0
PAPER_MIN_POSITION_USD=20
PAPER_MAX_OPEN_STAKE_PCT=0.88
MAX_OPEN_POSITIONS=48

# Hızlı dönüş — günde çok küçük kâr dilimleri
EDGE_THRESHOLD=0.044
KELLY_FRACTION=0.45
TAKE_PROFIT_STAKE_PCT=0.007
STOP_LOSS_STAKE_PCT=0.04
FAST_TP_STAKE_PCT=0.005
ULTRA_FAST_TP_STAKE_PCT=0.004
NANO_TP_STAKE_PCT=0.003
SCAN_INTERVAL_SEC=18
POSITION_CHECK_SEC=3
