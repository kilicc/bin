# Polymarket canlı CLOB — örnek ortam (bu dosyayı .env olarak KOPYALAMA; anahtarları asla commit etme)
# Resmi dokümantasyon: https://docs.polymarket.com/
# API girişi: https://docs.polymarket.com/api-reference/introduction
# CLOB quickstart / deposit wallet: https://docs.polymarket.com/developers/CLOB/quickstart
# Relayer v2 (gazsız on-chain): https://docs.polymarket.com/api-reference/relayer/submit-a-transaction
# POLY_RELAYER_BASE_URL=https://relayer-v2.polymarket.com
# RELAYER_API_KEY=<uuid>
# RELAYER_API_KEY_ADDRESS=0x...  (anahtarı sahip adres)

# --- Zorunlu güvenlik anahtarı (canlı emir) ---
POLYMARKET_LIVE_TRADING=1
POLYMARKET_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY_LOSS

# İmzalayan EOA private key (0x…). Asla repoya koyma.
POLYMARKET_PRIVATE_KEY=

# Deposit wallet / funder adresi (Polymarket hesabında gösterilen)
POLYMARKET_DEPOSIT_WALLET=

# Polymarket CLOB API (panel: API Key + Secret + Passphrase) — üçü birden dolu olmalı.
# Önerilir: otomatik derive/create yerine panelden kopyala (konsolda 400 uyarısı olmaz).
# POLYMARKET_CLOB_API_KEY=
# POLYMARKET_CLOB_API_SECRET=
# POLYMARKET_CLOB_API_PASSPHRASE=
# Otomatik modda "Could not create api key" = anahtar zaten var; derive ile devam edilir.

# İmza türü: 0=EOA, 1=PROXY, 2=GNOSIS_SAFE, 3=POLY_1271 (varsayılan 3)
# POLYMARKET_SIGNATURE_TYPE=3

# POLYMARKET_CLOB_HOST=https://clob.polymarket.com
# POLYMARKET_CHAIN_ID=137

# Canlı pozisyon veritabanı (varsayılan: data/live.db)
# LIVE_DB_PATH=data/live.db

# --- Pozisyon boyutu (Polymarket bakiyeni KOD çekmez; sen eşlersin) ---
# Her işlem için üst sınır (USD). 2 dolar tavan:
MAX_POSITION_USD=2
# Kelly bankroll — Polymarket’te işlem için ayırdığın yaklaşık bakiyeyi yaz
# (ör. cüzdanda $80 varsa 80). Kelly küçük tutulunca çoğu işlem zaten MAX’a takılır.
# STARTING_BALANCE=80
# KELLY_FRACTION=0.15
